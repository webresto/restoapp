#!/bin/bash
# Shared helpers for CI scripts
# Provides log_debug, log_info, log_warn, log_error and respects LOG_LEVEL (DEBUG|INFO|WARN|ERROR)

# Convert level name to numeric severity (lower means more verbose)
_helper_log_level_value() {
  case "${1^^}" in
    DEBUG) echo 0 ;;
    INFO) echo 1 ;;
    WARN) echo 2 ;;
    ERROR) echo 3 ;;
    *) echo 1 ;;
  esac
}

# Default LOG_LEVEL if not set
: ${LOG_LEVEL:=INFO}

# Internal logger that respects LOG_LEVEL
_helper_log() {
  local level="$1"; shift
  local msg="$*"
  local lvl_val=$(_helper_log_level_value "$level")
  local cur_val=$(_helper_log_level_value "${LOG_LEVEL}")
  if [ "$lvl_val" -ge "$cur_val" ]; then
    echo "$level: $msg" >&2
  fi
}

log_debug() { _helper_log DEBUG "$*"; }
log_info()  { _helper_log INFO "$*"; }
log_warn()  { _helper_log WARN "$*"; }
log_error() { _helper_log ERROR "$*"; }

# Parse boolean value from string
# Returns "true" or "false"
# Empty values are treated as false
parse_boolean() {
    local value="$1"
    if [[ -z "$value" ]]; then
        echo "false"
        return
    fi
    local true_values=("yes" "YES" "Yes" "1" "true" "TRUE" "True")
    local false_values=("no" "NO" "No" "0" "false" "FALSE" "False")
    for tv in "${true_values[@]}"; do
        if [[ "$value" == "$tv" ]]; then
            echo "true"
            return
        fi
    done
    for fv in "${false_values[@]}"; do
        if [[ "$value" == "$fv" ]]; then
            echo "false"
            return
        fi
    done
    # Default to false if not recognized
    echo "false"
}
