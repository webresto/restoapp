#!/bin/bash

# Enable debugging (uncomment to enable)
set -e

# Path to the script
SCRIPT_PATH="/app/modules/admin-frontend/.ci/bake_admin_frontend.js"
LOG_FILE="/app/modules/admin-frontend/.ci/script.log"

# Check if Node.js is installed
if ! command -v node &> /dev/null; then
    echo "Node.js is not installed. Please install Node.js to proceed."
    exit 1
fi

# Check if the script exists
if [ -f "$SCRIPT_PATH" ]; then
    # Record the start time
    START_TIME=$(date +%s)

    echo "AdminFrontend > $(cat /app/modules/admin-frontend/package.json | grep version)"
    # If the file exists, execute it using tsx and stream output to the Docker logs (no redirection)
    echo "Running: /usr/local/bin/tsx $SCRIPT_PATH"
    /usr/local/bin/tsx "$SCRIPT_PATH"
    EXIT_CODE=$?

    # List baked frontend (if created)
    ls -la /app/modules/admin-frontend/baked_frontend || true

    # Record the end time
    END_TIME=$(date +%s)

    # Calculate the elapsed time in seconds
    ELAPSED_TIME=$((END_TIME - START_TIME))

    # Check if the Node.js script exited with an error
    if [ $EXIT_CODE -ne 0 ]; then
        echo "Error: bake_admin_frontend failed with exit code $EXIT_CODE"
        echo "---- script log (if any) ----"
        [ -f "$LOG_FILE" ] && sed -n '1,200p' "$LOG_FILE" || echo "(no $LOG_FILE)"
        exit $EXIT_CODE
    else
        echo "Frontend build completed successfully in $ELAPSED_TIME seconds."
    fi
else
    # If the file does not exist, print a message and exit with code 0
    echo "Script bake_admin_frontend not found: $SCRIPT_PATH"
    exit 0
fi
