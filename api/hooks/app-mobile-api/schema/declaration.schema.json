{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://restoapp.org/schema/mobile-api/declaration.schema.json",
  "title": "RestoApp mobile API, protocol 1",
  "description": "The contract between the app-mobile-api hook and the mobile client. The hook validates every app and method registration against appRegistration / methodRegistration, so an unknown view, control, format or ui key fails at server start. The client runs its contract tests on the same file (copied into its test resources).",
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 64 },
    "methodName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*\\.[a-zA-Z0-9][a-zA-Z0-9-]*$", "maxLength": 128 },
    "text": { "type": "string", "minLength": 1, "maxLength": 200 },
    "tone": { "enum": ["info", "warning", "success", "danger"] },
    "format": { "enum": ["text", "number", "money", "percent", "datetime", "relative", "phone", "boolean", "enum", "image", "ref"] },

    "icon": {
      "description": "SVG path in a 24x24 box — AppIcon.Path in Superizer.",
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 8000 } }
    },

    "client": {
      "description": "This app is drawn by the client itself, not by the universal renderer: `native` names which built-in screen draws it, `min` the oldest client version that has it. A client that knows neither shows the app as a 'Needs a newer version' tile — it neither crashes nor hides it (order-entry.plan.md).",
      "type": "object",
      "additionalProperties": false,
      "required": ["native"],
      "properties": {
        "native": { "$ref": "#/definitions/id" },
        "min": { "type": "integer", "minimum": 1 }
      }
    },

    "open": {
      "description": "Where a tap leads. Without `app` — a method of the same app, with any params (`ui.open` is the default link of a uniform list and sends only `{id}`). With `app` — another app, and `place` is required when that app is by points. With `url` — an address outside the apps, http(s) or a path, which the client opens in the browser of the system (runtime.navigation.openUrl) and refuses otherwise: the settings page of a channel's provider module, the public address of a channel, a page of the marketplace. A path («/admin/…») is resolved by the client against the address of this server — the hook cannot know the address it is reached by. Exactly one of `method` and `url` is given. A link is built by the server after checking the rights (`ctx.canOpen`), and it is a hint and not a permission: the call it leads to is checked like any other; a client that understands neither key draws no line at all.",
      "type": "object",
      "additionalProperties": false,
      "oneOf": [{ "required": ["method"] }, { "required": ["url"] }],
      "properties": {
        "app": { "$ref": "#/definitions/id" },
        "method": { "$ref": "#/definitions/methodName" },
        "params": { "type": "object" },
        "place": { "type": "string" },
        "title": { "$ref": "#/definitions/text" },
        "url": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^(https?://|/)" }
      }
    },

    "link": {
      "description": "A line of a card that leads somewhere: «Применения · 12 →». The title is data (a count is in it), so it is not translated.",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "open"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "meta": { "type": "string", "maxLength": 200 },
        "open": { "$ref": "#/definitions/open" }
      }
    },

    "scriptSource": {
      "description": "What an app registers when its code comes as one JS file (script-apps.plan.md, D12): the built bundle inside the module that owns the app. The hook reads and hashes it at registration — the declaration carries a link and the hash, never the code.",
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "min": { "type": "integer", "minimum": 1 }
      }
    },

    "scriptRef": {
      "description": "The link to the bundle of a script app, with its hash: the hash is in the URL, so a new build is a new URL and what the client downloaded is good forever.",
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "size", "min"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1 },
        "min": { "type": "integer", "minimum": 1 }
      }
    },

    "module": {
      "description": "A module of this server as the app sees it: the system modules the installation is built of, and the modules installed from the marketplace. A module that brings a mobile app of its own carries that app's id and the link to its JS.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] },
        "kind": { "enum": ["system", "installed"] },
        "title": { "type": ["string", "null"] },
        "app": { "$ref": "#/definitions/id" },
        "script": { "$ref": "#/definitions/scriptRef" }
      }
    },

    "special": {
      "description": "A value with its own meaning: -1 is 'Unlimited', 0 is 'Out of stock'.",
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "title"],
      "properties": {
        "value": { "type": ["number", "string", "boolean"] },
        "title": { "$ref": "#/definitions/text" },
        "tone": { "$ref": "#/definitions/tone" }
      }
    },

    "field": {
      "description": "A field of a model as the user may see it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "title", "format"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" },
        "title": { "$ref": "#/definitions/text" },
        "format": { "$ref": "#/definitions/format" },
        "readonly": { "type": "boolean" },
        "section": { "$ref": "#/definitions/text" },
        "specials": { "type": "array", "items": { "$ref": "#/definitions/special" } },
        "x-titles": { "type": "object", "additionalProperties": { "$ref": "#/definitions/text" } },
        "access": {
          "description": "Who may see this field. Without it — everybody the app is available to. A field the user may not see is not in their declaration at all, and its values are not computed either (the handler asks `ctx.can`).",
          "$ref": "#/definitions/access"
        }
      }
    },

    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": { "fields": { "type": "array", "items": { "$ref": "#/definitions/field" } } }
    },

    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["stepper", "toggle", "buttons", "form", "native"] },
        "screen": {
          "description": "For `native`: which built-in screen of the client runs this action — the promotion editor of `marketing.plan.md`. A client that does not know it draws no action, which is what it already does for a control it does not know.",
          "$ref": "#/definitions/id"
        },
        "param": { "type": "string" },
        "bind": { "type": "string" },
        "specials": { "type": "array", "items": { "$ref": "#/definitions/special" } },
        "tones": { "type": "object", "additionalProperties": { "$ref": "#/definitions/tone" } }
      }
    },

    "ui": {
      "description": "Screen hints, version 1. Exactly these keys; anything else is refused at registration.",
      "type": "object",
      "additionalProperties": false,
      "required": ["view"],
      "properties": {
        "view": { "enum": ["list", "detail", "action"] },
        "item": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string" },
            "subtitle": { "type": "string" },
            "meta": { "type": "string" },
            "value": { "type": "string" },
            "badge": { "type": "string" },
            "image": { "type": "string" }
          }
        },
        "groupBy": { "type": "string" },
        "search": { "type": "string" },
        "chips": { "type": "string" },
        "open": { "$ref": "#/definitions/methodName" },
        "empty": { "$ref": "#/definitions/text" },
        "on": { "type": "string", "description": "Model the action is shown on; 'list' — on the list screen itself." },
        "placement": { "type": "array", "items": { "enum": ["row", "detail", "list"] }, "uniqueItems": true },
        "control": { "$ref": "#/definitions/control" },
        "confirm": { "$ref": "#/definitions/text" },
        "specials": { "type": "array", "items": { "$ref": "#/definitions/special" } },
        "bind": { "type": "string" },
        "param": { "type": "string" }
      }
    },

    "access": {
      "description": "Who may see and call. Without it a registration is refused: there are no silently open methods.",
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["public"],
          "properties": { "public": { "const": true } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["token"],
          "properties": {
            "token": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                {
                  "description": "A token of its own: the hook registers it in the 'Mobile app' department.",
                  "type": "object", "additionalProperties": false, "required": ["id", "name"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^mobile-app-[a-z0-9-]+$" },
                    "name": { "$ref": "#/definitions/text" },
                    "description": { "$ref": "#/definitions/text" }
                  }
                }
              ]
            }
          }
        },
        {
          "description": "Every one of them.",
          "type": "object", "additionalProperties": false, "required": ["tokens"],
          "properties": { "tokens": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }
        },
        {
          "description": "Any one of them — the two rights of the Marketing section, either of which opens its summary.",
          "type": "object", "additionalProperties": false, "required": ["anyOf"],
          "properties": { "anyOf": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }
        }
      ]
    },

    "appRegistration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title", "home"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
        "title": { "$ref": "#/definitions/text" },
        "icon": { "$ref": "#/definitions/icon" },
        "category": { "$ref": "#/definitions/text" },
        "home": { "$ref": "#/definitions/methodName" },
        "scope": { "enum": ["server", "place"] },
        "places": {
          "description": "Where the points of a scope:'place' app come from: the points granted by this contextual token, as in the web.",
          "type": "object",
          "additionalProperties": false,
          "required": ["token", "kind"],
          "properties": {
            "token": { "type": "string", "minLength": 1 },
            "kind": { "enum": ["cooking", "pickup", "any"] },
            "options": {
              "description": "Options of the same token the app shows among its points although they are not Places — «Без кухни» of «Заказы». Titles are translation keys.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "title"],
                "properties": { "id": { "$ref": "#/definitions/id" }, "title": { "$ref": "#/definitions/text" } }
              }
            }
          }
        },
        "models": { "type": "object", "additionalProperties": { "$ref": "#/definitions/model" } },
        "client": { "$ref": "#/definitions/client" },
        "script": { "$ref": "#/definitions/scriptSource" },
        "module": { "description": "The module that owns this app, by its appId: that is how the modules of the declaration carry the link to their JS.", "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "scope": { "const": "place" } }, "required": ["scope"] },
      "then": { "required": ["places"] },
      "else": { "not": { "required": ["places"] } }
    },

    "methodRegistration": {
      "description": "The JSON part of registerMethod. handler, describe and describeItem are functions and are checked separately.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "app", "kind", "title", "access", "input"],
      "properties": {
        "name": { "$ref": "#/definitions/methodName" },
        "app": { "$ref": "#/definitions/id" },
        "kind": { "enum": ["query", "mutation"] },
        "title": { "$ref": "#/definitions/text" },
        "access": { "$ref": "#/definitions/access" },
        "input": { "type": "object", "required": ["type"], "properties": { "type": { "const": "object" } } },
        "model": { "type": "string", "description": "Model of the records a query returns; their _actions are the actions with ui.on equal to it." },
        "ui": { "$ref": "#/definitions/ui" }
      }
    },

    "declaredMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "title", "input"],
      "properties": {
        "name": { "$ref": "#/definitions/methodName" },
        "kind": { "enum": ["query", "mutation"] },
        "title": { "type": "string" },
        "input": { "type": "object" },
        "model": { "type": "string" },
        "ui": { "$ref": "#/definitions/ui" }
      }
    },

    "declaredApp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title", "home", "scope", "methods"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "version": { "type": "string" },
        "title": { "type": "string" },
        "icon": { "$ref": "#/definitions/icon" },
        "category": { "type": "string" },
        "home": { "$ref": "#/definitions/methodName" },
        "scope": { "enum": ["server", "place"] },
        "places": { "type": "array", "items": { "type": "string" } },
        "models": { "type": "object", "additionalProperties": { "$ref": "#/definitions/model" } },
        "client": { "$ref": "#/definitions/client" },
        "methods": { "type": "array", "items": { "$ref": "#/definitions/declaredMethod" } },
        "script": { "$ref": "#/definitions/scriptRef" }
      }
    },

    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "address": { "type": ["string", "null"] }
      }
    },

    "declaration": {
      "description": "GET /api/mobile/describe → {result: declaration}",
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "revision", "server", "user", "places", "apps"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "revision": { "type": "string" },
        "server": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "version": { "type": ["string", "null"] },
            "currency": { "type": ["string", "null"] },
            "timezone": { "type": ["string", "null"] },
            "locale": { "type": ["string", "null"] }
          }
        },
        "user": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "login"],
          "properties": {
            "id": { "type": ["string", "number"] },
            "login": { "type": "string" },
            "fullName": { "type": ["string", "null"] },
            "isAdministrator": { "type": "boolean" }
          }
        },
        "places": { "type": "array", "items": { "$ref": "#/definitions/place" } },
        "apps": { "type": "array", "items": { "$ref": "#/definitions/declaredApp" } },
        "modules": { "description": "Every module of this server by id: what it is built of, and what was installed into it.", "type": "array", "items": { "$ref": "#/definitions/module" } }
      }
    },

    "callRequest": {
      "description": "POST /api/mobile/call/:method. place is required exactly for the methods of scope:'place' apps and refused for the rest.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "params": { "type": "object" },
        "place": { "type": "string", "minLength": 1 }
      }
    },

    "action": {
      "description": "An action available on one record. input narrows the method's input for this record (e.g. the allowed transitions).",
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": { "method": { "$ref": "#/definitions/methodName" }, "input": { "type": "object" } }
    },

    "listResult": {
      "type": "object",
      "required": ["items", "nextCursor"],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "_actions": { "type": "array", "items": { "$ref": "#/definitions/action" } },
              "_open": { "$ref": "#/definitions/open" }
            }
          }
        },
        "nextCursor": { "type": ["string", "null"] },
        "counts": { "type": "object", "additionalProperties": { "type": "integer" } },
        "total": { "type": "integer" }
      }
    },

    "itemResult": {
      "type": "object",
      "required": ["item"],
      "properties": {
        "item": {
          "type": "object",
          "properties": {
            "_actions": { "type": "array", "items": { "$ref": "#/definitions/action" } },
            "_open": { "$ref": "#/definitions/open" },
            "_links": { "type": "array", "items": { "$ref": "#/definitions/link" } }
          }
        }
      }
    },

    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": {
              "enum": [
                "unauthorized", "forbidden", "place_forbidden", "invalid", "not_found", "conflict",
                "rate_limited", "unavailable", "invalid_credentials", "captcha_invalid", "https_required",
                "too_large", "internal"
              ]
            },
            "message": { "type": "string" },
            "retryable": { "type": "boolean" },
            "details": {}
          }
        }
      }
    },

    "loginRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["login", "password", "device"],
      "properties": {
        "login": { "type": "string", "minLength": 1, "maxLength": 200 },
        "password": { "type": "string", "minLength": 1, "maxLength": 500 },
        "captchaSolution": { "type": "string", "maxLength": 1000 },
        "device": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "platform"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 100 },
            "platform": { "type": "string", "minLength": 1, "maxLength": 50 }
          }
        }
      }
    }
  }
}
