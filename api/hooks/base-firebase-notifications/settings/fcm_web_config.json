{
  "key": "FCM_WEB_CONFIG",
  "type": "json",
  "name": "FCM Web Config",
  "description": "Public Firebase config for browser push notifications. The values come from the Firebase web app config and the Web Push certificates.",
  "tooltip": "At minimum apiKey, projectId, messagingSenderId, appId and vapidKey are required. These values are safe to send to the client.",
  "defaultValue": null,
  "isRequired": false,
  "module": "base-firebase-notifications",
  "jsonSchema": {
    "type": "object",
    "required": ["apiKey", "projectId", "messagingSenderId", "appId", "vapidKey"],
    "additionalProperties": true,
    "properties": {
      "apiKey": { "type": "string", "minLength": 1 },
      "authDomain": { "type": "string" },
      "projectId": { "type": "string", "minLength": 1 },
      "storageBucket": { "type": "string" },
      "messagingSenderId": { "type": "string", "minLength": 1 },
      "appId": { "type": "string", "minLength": 1 },
      "measurementId": { "type": "string" },
      "vapidKey": { "type": "string", "minLength": 1 }
    }
  }
}
