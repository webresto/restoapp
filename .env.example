JWT_SECRET=your_jwt_secret_here

# OpenHarness agent via LiteLLM / OpenAI-compatible endpoint
# Example external LiteLLM setup:
# OPENHARNESS_API_KEY=sk-...
# OPENHARNESS_BASE_URL=https://lllm.m42.cx/v1
# OPENHARNESS_MODEL=Silly
# Key must belong to the LiteLLM "grs" team, which exposes 3 named models:
#   Genius (gpt-4o), Regular (local-qwen3.6-27b), Silly (local-lfm25-agent)
OPENHARNESS_API_KEY=
OPENHARNESS_BASE_URL=
OPENHARNESS_MODEL=
OPENHARNESS_CONTEXT_WINDOW=128000
OPENHARNESS_VISION=false
OPENHARNESS_FILE_STORE=.tmp/openharness-agent/files

# Optional: disable in-process MCP tools for the OpenHarness agent.
OPENHARNESS_MCP_TOOLS=true
