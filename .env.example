JWT_SECRET=your_jwt_secret_here

# OpenHarness agent (OpenAI-compatible chat completions endpoint)
OPENHARNESS_API_KEY=
OPENHARNESS_BASE_URL=
OPENHARNESS_MODEL=
OPENHARNESS_CONTEXT_WINDOW=128000
OPENHARNESS_VISION=false

# Optional: disable in-process MCP tools for the OpenHarness agent.
OPENHARNESS_MCP_TOOLS=true
