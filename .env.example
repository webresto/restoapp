JWT_SECRET=your_jwt_secret_here
# OPENHARNESS_API_KEY=
# OPENHARNESS_BROKER_TOKEN=

# Prometheus /metrics — the endpoint stays off until a token is set.
# Generate with: openssl rand -hex 32. Details: api/hooks/metrics/docs.md
# METRICS_TOKEN=
# STACK_NAME=
# Admin panel PoW CAPTCHA on the login form (default: true).
# Set to false only for local development — over plain http on a non-localhost
# host the CAPTCHA cannot be solved (crypto.subtle needs https/localhost).
# ENABLE_ADMIN_CAPTCHA=false

# Salt of the admin panel passwords: login + password + AP_PASSWORD_SALT. The web login and the
# mobile API read the same value; changing it invalidates every password.
# AP_PASSWORD_SALT=

# Express "trust proxy" (config/http.js): hops in front of Sails. 1 = the nginx of the image.
# Set 2 when another proxy terminates TLS in front of it, or a list such as "loopback, 10.0.0.0/8".
# TRUST_PROXY=1

# PM2 mode of the image (.ci/bootstrap): FORK (default, one process) or CLUSTER (one per CPU).
# PM2_MODE=FORK

# Mobile admin app API on /api/mobile (api/hooks/app-mobile-api/docs.md). Off by default; while off
# it answers 503. Its access rights are registered in the admin panel either way.
# MOBILE_API_ENABLED=false
# Secret of the login CAPTCHA signatures, shared by all workers. Default: JWT_SECRET.
# MOBILE_API_SECRET=
# HTTPS only (by X-Forwarded-Proto through TRUST_PROXY). Default: on when NODE_ENV=production.
# MOBILE_API_REQUIRE_HTTPS=true
# Base PoW CAPTCHA duration in ms for the web and the app login (default 3000).
# CAPTCHA_POW_DIFFICULTY=3000
